{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-latest.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/fragment-image.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    }
  ]
}

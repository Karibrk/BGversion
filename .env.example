# Server-only. Never prefix these with NEXT_PUBLIC_.
# BANDD_SYNC_KEY keeps the current browser UI and existing clients working.
BANDD_SYNC_KEY
# Optional dedicated write credentials for external AI agents.
# Send one as `Authorization: Bearer <key>` or `x-bandd-key: <key>`.
BANDD_GPT_KEY
BANDD_CLAUDE_KEY
BANDD_GROK_KEY
GITHUB_TOKEN=
GITHUB_REPO=Karibrk/Bernov-Dragons-GPT
GITHUB_BRANCH=main
# Optional override. Vercel OIDC can authenticate AI Gateway automatically.
BANDD_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# BLOB_READ_WRITE_TOKEN is normally injected by the connected Vercel Blob store.
